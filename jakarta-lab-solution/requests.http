### Get all cuisines
GET http://localhost:9080/api/cuisines

### Get Polish cuisine by id
GET http://localhost:9080/api/cuisines/01b14723-fe2a-4bd6-a63e-3cdc5c34df7d

### Get all users
GET http://localhost:9080/api/users

### Triss by id
GET http://localhost:9080/api/users/0ceb983a-1529-40c7-9d83-dc29acae7b55

### Get all recipes
GET http://localhost:9080/api/recipes

### Create a recipe
POST http://localhost:9080/api/recipes
Content-Type: application/json

{
  "title": "Pierogi ruskie",
  "description": "Dumplings filled with potato and cottage cheese.",
  "cuisine": "01b14723-fe2a-4bd6-a63e-3cdc5c34df7d",
  "author": "deb9a5f8-fec3-4d98-b8fb-f78965e16700",
  "ingredients": [
    { "name": "Potato", "quantity": 400, "unit": "g" },
    { "name": "Cottage", "quantity": 200, "unit": "g" }
  ],
  "servings": 4,
  "calories": 600,
  "vegetarian": true
}

> {%
    client.global.set("recipeId", response.body.id);
%}

### Get the created recipe by id
GET http://localhost:9080/api/recipes/{{recipeId}}

### Update the created recipe
PUT http://localhost:9080/api/recipes/{{recipeId}}
Content-Type: application/json

{
  "title": "Pierogi ruskie (updated)",
  "description": "Dumplings filled with potato and cottage cheese, extra creamy.",
  "cuisine": "01b14723-fe2a-4bd6-a63e-3cdc5c34df7d",
  "author": "deb9a5f8-fec3-4d98-b8fb-f78965e16700",
  "ingredients": [
    { "name": "Potato", "quantity": 500, "unit": "g" },
    { "name": "Cottage", "quantity": 250, "unit": "g" }
  ],
  "servings": 5,
  "calories": 800,
  "vegetarian": true
}

### Delete the created recipe
DELETE http://localhost:9080/api/recipes/{{recipeId}}

### Not found - unknown but valid UUID
GET http://localhost:9080/api/cuisines/99999999-9999-9999-9999-999999999999

### Bad request - malformed id
GET http://localhost:9080/api/cuisines/not-uuid
