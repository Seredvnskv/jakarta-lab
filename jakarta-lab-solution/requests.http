### Get all cuisines

GET http://localhost:9080/api/cuisine

### Get cuisine by uuid (Polish)

GET http://localhost:9080/api/cuisine/d290f1ee-6c54-4b01-90e6-d701748f0001

### Create cuisine (Mexican)

POST http://localhost:9080/api/cuisine
Content-Type: application/json

{
  "name": "Mexican",
  "continent": "NORTH_AMERICA",
  "spicy": true
}

### Update cuisine (Scandinavian -> now spicy and continent ASIA)

PUT http://localhost:9080/api/cuisine/d290f1ee-6c54-4b01-90e6-d701748f0004
Content-Type: application/json

{
  "name": "Scandinavian",
  "continent": "ASIA",
  "spicy": true
}

### Delete cuisine (Moroccan)

DELETE http://localhost:9080/api/cuisine/d290f1ee-6c54-4b01-90e6-d701748f0005


### Get all recipes for Polish cuisine

GET http://localhost:9080/api/cuisine/d290f1ee-6c54-4b01-90e6-d701748f0001/recipe

### Get recipe by uuid within its cuisine (Bigos, Polish)

GET http://localhost:9080/api/cuisine/d290f1ee-6c54-4b01-90e6-d701748f0001/recipe/a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a01

### Create recipe under French cuisine

POST http://localhost:9080/api/cuisine/d290f1ee-6c54-4b01-90e6-d701748f0003/recipe
Content-Type: application/json

{
  "authorId": "6b04e739-3251-4f8a-a962-5e1d8b1a592d",
  "ingredients": ["snails", "garlic", "butter", "parsley", "white wine"],
  "title": "Garlic Snail Stew",
  "description": "A classic French escargot preparation.",
  "servings": 2,
  "caloriesPerServing": 410,
  "vegetarian": false
}

### Update recipe (Zurek, Polish) - change title and servings

PUT http://localhost:9080/api/cuisine/d290f1ee-6c54-4b01-90e6-d701748f0001/recipe/a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a02
Content-Type: application/json

{
  "authorId": "6b04e739-3251-4f8a-a962-5e1d8b1a592d",
  "ingredients": ["fermented rye starter", "white sausage", "potatoes", "marjoram", "garlic", "hard-boiled egg"],
  "title": "Zurek Deluxe",
  "description": "Tangy fermented rye soup, now with extra sausage.",
  "servings": 6,
  "caloriesPerServing": 450,
  "vegetarian": false
}

### Delete recipe (Krupnik, Polish)

DELETE http://localhost:9080/api/cuisine/d290f1ee-6c54-4b01-90e6-d701748f0001/recipe/a0eebc99-9c0b-4ef8-bb6d-6bb9bd380a04
