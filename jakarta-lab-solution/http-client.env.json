{
  "dev": {
    "Security": {
      "Auth": {
        "jakarta-lab-auth": {
          "Type": "OAuth2",
          "Grant Type": "Authorization Code",
          "Client ID": "jakarta-lab",
          "Client Secret": "jakarta-lab-secret",
          "Auth URL": "http://localhost:9090/oauth2/authorize",
          "Token URL": "http://localhost:9090/oauth2/token",
          "Redirect URL": "http://localhost:9080/Callback",
          "Scope": "openid read-write"
        }
      }
    }
  }
}
